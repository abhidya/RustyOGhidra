# port-model.env.example -- this machine's AUTHORITATIVE port-pipeline .env,
# with the secrets replaced by placeholders.
#
# WHY THIS FILE EXISTS SEPARATELY FROM .env.example
#   .env.example is upstream LLNL/OGhidra's generic template: it documents every
#   provider (ollama / external / custom_api) with placeholder values and must
#   stay that way, or every rebase conflicts. This file is the opposite -- the
#   specific, working port configuration this rig runs, so a fresh clone can
#   reproduce it instead of rediscovering it.
#
# WHY IT IS AUTHORITATIVE
#   src/config.py calls load_dotenv(<repo root>/.env, override=True), so THE
#   FILE WINS OVER THE PROCESS ENVIRONMENT. src/port_model_config.py resolves it
#   with exactly those rules, and the rig supervisor (D:
ig) reads that resolver
#   rather than naming a model itself -- by construction it has no field that
#   could hold one. There must be no second copy: src/.env is a dead tombstone.
#
# USE
#   cp port-model.env.example .env      # then fill in the REPLACE-ME secrets
#   python main.py port-contract config --json    # what it resolves to
#
# The values below are live as of 2026-08-16. Two of them carry hard-won
# reasoning; the inline comments explain which and why.
LLM_PROVIDER=custom_api
CUSTOM_API_URL=http://127.0.0.1:8888/v1/chat/completions
CUSTOM_API_KEY=sk-unsloth-REPLACE-ME
# 2026-08-18: Qwen3.8-27B (released Aug 14). No MTP build exists for 3.8, so
# speculative decoding is gone; measured 3.0 tok/s on this rig vs colibri's
# CPU-only DeepSeek-V4 at 0.147 tok/s. Hybrid attention (16 of 64 layers full,
# 48 Gated DeltaNet linear) keeps KV small, so a larger served context may be
# affordable here later -- measure before raising.
CUSTOM_API_MODEL=unsloth/Qwen3.8-27B-GGUF
CUSTOM_API_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
CUSTOM_API_EMBEDDING_URL=http://10.0.0.205:1234
CUSTOM_API_TIMEOUT=1200
CUSTOM_API_TEMPERATURE=0.6
# 2026-08-16: 16348 reserved HALF the 32,768 window for output. The context
# gate compares prompt_tokens + max_tokens against the served context, so a
# ~10k-token prompt scored as needing ~34k and was rejected -- while the
# compile-fix task actually emits ONE header (~1.6-2k tokens). 8192 keeps 4x
# headroom over the real output and lifts the gate pass rate 93.3% -> 98.5%
# across the 1,520-unit queue. This is an OUTPUT cap, not a serving
# parameter: it does not touch KV/GPU and cannot cause a CPU spill.
CUSTOM_API_MAX_TOKENS=8192
CUSTOM_API_VERIFY_SSL=false
CUSTOM_API_REQUEST_DELAY=0.2
CUSTOM_API_MAX_RETRIES=3
CUSTOM_API_MAX_CONCURRENCY=1
CUSTOM_API_GLOBAL_MIN_INTERVAL=0.2

GHIDRA_BASE_URL=http://localhost:8080/
GHIDRA_TIMEOUT=60
GHIDRA_MOCK_MODE=false

# NOTE mixed units: context_manager reads this as TOKENS (must stay < the model's
# 262k window), session_compactor reads it as CHARS. 200000 works for both: 200k-token
# prompt budget, and compaction (at 0.70) fires at 140k chars instead of pointlessly
# LLM-summarizing 14k-char sessions like the old 20000 did.
CONTEXT_BUDGET=200000
MAX_EXECUTION_STEPS=5
MAX_AGENTIC_CYCLES=2
AGENTIC_LOOP_ENABLED=true

RESULT_CACHE_ENABLED=false
TIERED_CONTEXT_ENABLED=true
ENABLE_RESULT_SUMMARIZATION=true
COMPACTION_ENABLED=true
COMPACTION_THRESHOLD=0.70
COMPACTION_AUTO=true

LLM_LOGGING_ENABLED=true
LLM_LOG_FILE=logs/llm_interactions_lmstudio_nemotron3.json
LLM_LOG_PROMPTS=true
LLM_LOG_RESPONSES=true
LLM_LOG_TOKENS=true
LLM_LOG_TIMING=true
LLM_LOG_FORMAT=json

OGHIDRA_PORT_REQUEST_LIMIT=1000
OGHIDRA_PORT_CONTEXT_TOKENS=131072

# Phase-A flip (2026-08-10): thinking 27B for wasm-unit compile-fix; 32k ctx
# keeps prompts+thinking on-GPU (262k spills KV to CPU, ~50 min/call).
CUSTOM_API_GGUF_VARIANT=UD-Q4_K_XL
CUSTOM_API_MAX_SEQ_LEN=32768
OGHIDRA_PORT_MODE=wasm_units
